.env.example@'
# Banco
POSTGRES_USER=nexusauto
POSTGRES_PASSWORD=
POSTGRES_DB=nexus_auto
POSTGRES_PORT=5439
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5439/nexus_auto

# Auth (gere com: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# CORS / front
FRONTEND_ORIGIN=http://localhost:5173

# Bucket S3-compativel (Cloudflare R2 ou Supabase Storage)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# E-mail (Resend ou SMTP)
RESEND_API_KEY=
EMAIL_FROM=
'@ | Set-Content -Encoding utf8 .env.example